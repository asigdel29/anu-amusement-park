{
  "name": "anu-amusement-park",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:regression": "playwright test --config=playwright.regression.config.ts",
    "test:perf": "node perf/run.mjs",
    "size": "node scripts/checkBundleSize.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "assets:export": "sh assets/pipeline/export.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "debugging reality \u2014 an amusement park of things Anubhav Sigdel has built"
}
